{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckanban.dev/contracts/schemas/ticket.schema.json",
  "title": "Ticket",
  "description": "profiles/<slug>/tickets/<id>/ticket.md: YAML front matter plus a Markdown body, exactly \"---\\n\" + YAML.stringify(fields) + \"---\\n\" + body (src/core/store.ts serializeTicket; yaml npm package v2, YAML 1.2 core schema, so ISO times are plain strings). This schema describes the parsed front matter object with the body added as the field body (which is not in the front matter). Type Ticket in src/core/types.ts. Store.createTicket always writes the required fields; mode is also always written today but is not required because tickets from before modes lack it (read as auto). Optional fields are only written when set, and patches append new keys at the end. Nested records are described loosely; see types.ts for every field. Unknown fields must be kept.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "status", "order", "sessionId", "worktree", "branch", "prUrl", "outcome", "lastActivity", "lastRunAt", "runCount", "error", "createdAt", "updatedAt", "body"],
  "$defs": {
    "status": { "enum": ["backlog", "planning", "ready", "in_progress", "review", "done"] },
    "outcome": { "enum": [null, "done", "blocked", "failed", "stopped", "needs_input", "limit"] },
    "kind": { "enum": [null, "explore", "build", "test", "review", "fix", "group", "round", "with_you"] },
    "obj": { "type": "object", "additionalProperties": true },
    "nullableObj": { "type": ["object", "null"], "additionalProperties": true },
    "strings": { "type": "array", "items": { "type": "string" } }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^t_[0-9]{8}_[0-9a-z]{4}$", "description": "t_<UTC YYYYMMDD>_<4 base36>. Equals the folder name." },
    "title": { "type": "string" },
    "status": { "$ref": "#/$defs/status" },
    "mode": { "enum": ["interview", "auto"], "description": "Missing: auto." },
    "order": { "type": "number", "description": "Position in its column (lower is higher up). Ready appends (max+1), other columns put new arrivals on top (min-1)." },
    "sessionId": { "type": ["string", "null"], "description": "Claude Code session UUID." },
    "worktree": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "prUrl": { "type": ["string", "null"] },
    "outcome": { "$ref": "#/$defs/outcome" },
    "lastActivity": { "type": ["string", "null"] },
    "lastRunAt": { "type": ["string", "null"] },
    "runCount": { "type": "integer", "minimum": 0 },
    "error": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "body": { "type": "string", "description": "Everything after the closing --- line, unchanged." },

    "interviewed": { "type": "boolean" },
    "sessionStarted": { "type": "boolean" },
    "toolsVersion": { "type": "string" },
    "freshSession": { "type": "boolean" },
    "freshAuto": { "type": ["boolean", "null"] },
    "freshFromPlanning": { "type": ["boolean", "null"], "description": "The work started in a fresh chat after a long planning chat; cleared once that chat starts." },
    "earlierSessions": { "type": "array", "items": { "$ref": "#/$defs/obj" } },
    "rewindUndo": { "$ref": "#/$defs/nullableObj" },
    "refineStarted": { "type": "boolean" },
    "setupPending": { "type": "boolean" },
    "workdir": { "type": ["string", "null"] },
    "baseSha": { "type": ["string", "null"] },
    "prs": { "type": ["array", "null"], "items": { "$ref": "#/$defs/obj" } },
    "pr": { "$ref": "#/$defs/nullableObj" },
    "lastActivityAt": { "type": ["string", "null"] },
    "runEndedAt": { "type": ["string", "null"] },
    "runStartedAt": { "type": ["string", "null"] },
    "stalled": { "$ref": "#/$defs/nullableObj" },
    "waitingOn": { "type": ["array", "null"], "items": { "$ref": "#/$defs/obj" } },
    "notice": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "effort": { "type": ["string", "null"] },
    "ultracode": { "type": ["boolean", "null"] },
    "chrome": { "type": ["string", "null"] },
    "browsers": { "type": ["array", "null"], "items": { "$ref": "#/$defs/obj" } },
    "scheduleId": { "type": ["string", "null"] },
    "raisedBy": { "$ref": "#/$defs/nullableObj" },
    "jobId": { "type": ["string", "null"] },
    "source": { "$ref": "#/$defs/nullableObj" },
    "waitsForStart": { "type": "boolean" },
    "parentId": { "type": ["string", "null"] },
    "planKey": { "type": ["string", "null"] },
    "proposedAs": { "type": ["string", "null"] },
    "dependsOn": { "$ref": "#/$defs/strings" },
    "needs": { "$ref": "#/$defs/strings" },
    "tags": { "$ref": "#/$defs/strings" },
    "suggestedTags": { "$ref": "#/$defs/strings" },
    "branchedFrom": { "type": ["string", "null"] },
    "branchPoint": { "$ref": "#/$defs/nullableObj" },
    "madeFrom": { "type": ["string", "null"] },
    "partOf": { "type": ["string", "null"] },
    "kind": { "$ref": "#/$defs/kind" },
    "verdict": { "enum": ["passed", "problem", null] },
    "statusAt": { "type": ["string", "null"] },
    "partOfVia": { "enum": ["chat", null] },
    "parentSuggestion": { "$ref": "#/$defs/nullableObj" },
    "parentChecked": { "type": "boolean" },
    "startFrom": { "type": ["string", "null"] },
    "doneAt": { "type": ["string", "null"], "description": "Set by the Store when the status becomes done." },
    "reopenedFrom": { "$ref": "#/$defs/nullableObj" },
    "startedBy": { "$ref": "#/$defs/nullableObj" },
    "plan": { "$ref": "#/$defs/nullableObj" },
    "main": { "type": "boolean" },
    "tool": { "type": "boolean" },
    "showOnBoard": { "type": ["boolean", "null"] },
    "results": { "type": "array", "items": { "$ref": "#/$defs/obj" } },
    "boardNotes": { "type": "array", "items": { "$ref": "#/$defs/obj" } },
    "mergeFails": { "type": "number" },
    "merged": { "type": ["string", "null"] },
    "startSha": { "type": ["string", "null"] },
    "queued": { "type": "array", "items": { "$ref": "#/$defs/obj" } },
    "telegramIn": { "type": "array", "items": { "$ref": "#/$defs/obj" } },
    "telegramOut": { "type": "array", "items": { "$ref": "#/$defs/obj" } },
    "telegramReport": { "$ref": "#/$defs/nullableObj" },
    "interrupted": { "$ref": "#/$defs/nullableObj" },
    "slotWait": { "$ref": "#/$defs/nullableObj" },
    "snooze": { "$ref": "#/$defs/nullableObj" },
    "important": { "type": "boolean" },
    "pinnedAt": { "type": ["string", "null"], "description": "Cleared by the Store when the status becomes done." },
    "autoHuddle": { "$ref": "#/$defs/nullableObj" },
    "followUp": { "$ref": "#/$defs/nullableObj" },
    "followUpLog": { "type": "array", "items": { "$ref": "#/$defs/obj" } },
    "followUpRun": { "$ref": "#/$defs/nullableObj" },
    "followUpStopped": { "$ref": "#/$defs/nullableObj" },
    "seenAt": { "type": ["string", "null"] },
    "limit": { "$ref": "#/$defs/nullableObj" },
    "runCapUsd": { "type": ["number", "null"] },
    "capHit": { "$ref": "#/$defs/nullableObj" },
    "capNextUsd": { "type": ["number", "null"] },
    "autoContinue": { "type": "boolean" },
    "autoContinued": { "$ref": "#/$defs/nullableObj" },
    "shareLinks": { "type": "array", "items": { "$ref": "#/$defs/obj" } },
    "teammateCards": { "$ref": "#/$defs/obj" },
    "squadCards": { "$ref": "#/$defs/obj" },
    "scheduleDeleteCards": { "$ref": "#/$defs/obj" },
    "helperRuleCards": { "$ref": "#/$defs/obj" },
    "automationCards": { "$ref": "#/$defs/obj" },
    "keyCards": { "$ref": "#/$defs/obj" },
    "closedForms": { "$ref": "#/$defs/obj" },
    "automationSetup": { "type": "boolean" },
    "checkinSetup": { "type": "boolean" }
  }
}

{
  "about": "Bodies from Anthropic's usage endpoint and what normalizeUsage (src/usage/usage.ts) makes of them (null: not the expected shape). `expect` is written by test/rust-fixtures.test.ts.",
  "cases": [
    {
      "name": "contract body",
      "body": {
        "five_hour": {
          "utilization": 42,
          "resets_at": "2026-11-15T15:00:00.000Z"
        },
        "seven_day": {
          "utilization": 17.5,
          "resets_at": null

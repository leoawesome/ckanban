{
  "about": "Stored logins (keychain items, then the credentials file; null is a missing one) and what pickCredentials (src/usage/usage.ts) picks. `expect` is written by test/rust-fixtures.test.ts.",
  "cases": [
    {
      "name": "file only",
      "raws": [
        null,
        null,
        "{\"claudeAiOauth\":{\"accessToken\":\"tok-file\",\"expiresAt\":1794740400000}}"
      ],
      "expect": {
        "token": "tok-file",
        "expiresAt": 1794740400000
      }
    },
    {
      "name": "latest expiry wins",
      "raws": [
        "{\"claudeAiOauth\":{\"accessToken\":\"old\",\"expiresAt\":1000}}",
        "{\"claudeAiOauth\":{\"accessToken\":\"new\",\"expiresAt\":2000}}",
        "{\"claudeAiOauth\":{\"accessToken\":\"mid\",\"expiresAt\":1500}}"
      ],
      "expect": {
        "token": "new",
        "expiresAt": 2000
      }
    },
    {
      "name": "no expiry counts as latest",
      "raws": [
        "{\"claudeAiOauth\":{\"accessToken\":\"dated\",\"expiresAt\":99999999999999}}",
        "{\"claudeAiOauth\":{\"accessToken\":\"forever\"}}"
      ],
      "expect": {
        "token": "forever",
        "expiresAt": null
      }
    },
    {
      "name": "first of equals wins",
      "raws": [
        "{\"claudeAiOauth\":{\"accessToken\":\"one\"}}",
        "{\"claudeAiOauth\":{\"accessToken\":\"two\"}}"
      ],
      "expect": {
        "token": "one",
        "expiresAt": null
      }
    },
    {
      "name": "unreadable then good",
      "raws": [
        "{not json",
        "{\"claudeAiOauth\":{\"accessToken\":\"ok\",\"expiresAt\":\"soon\"}}"
      ],
      "expect": {
        "token": "ok",
        "expiresAt": null
      }
    },
    {
      "name": "only bad ones: first error",
      "raws": [
        "{\"claudeAiOauth\":{\"accessToken\":\"\"}}",
        "{oops",
        "{}"
      ],
      "expect": {
        "error": "Not logged in to Claude Code with a Claude plan"
      }
    },
    {
      "name": "api key login, no plan",
      "raws": [
        "{\"primaryApiKey\":\"sk-x\"}"
      ],
      "expect": {
        "error": "Not logged in to Claude Code with a Claude plan"
      }
    },
    {
      "name": "nothing stored",
      "raws": [
        null,
        "",
        null
      ],
      "expect": {
        "error": "Not logged in to Claude Code"
      }
    }
  ]
}

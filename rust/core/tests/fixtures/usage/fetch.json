{
  "about": "One usage check: the stored logins, the clock (`now`, epoch ms) and the endpoint's reply; `expect.result` is what fetchUsage (src/usage/usage.ts) returns and `expect.sent` the auth headers it sent (null: it did not ask). `expect` is written by test/rust-fixtures.test.ts.",
  "now": 1794744000000,
  "cases": [
    {
      "name": "good",
      "raws": [
        "{\"claudeAiOauth\":{\"accessToken\":\"tok-good\",\"expiresAt\":1794747600000}}"
      ],
      "reply": {
        "status": 200,
        "body": "{\"five_hour\":{\"utilization\":42,\"resets_at\":\"2026-11-15T15:00:00.000Z\"},\"seven_day\":{\"utilization\":17.5,\"resets_at\":null}}"
      },
      "expect": {
        "result": {
          "windows": [
            {
              "key": "five_hour",
              "label": "Current session (5h)",
              "percent": 42,
              "resetsAt": "2026-11-15T15:00:00.000Z"
            },
            {
              "key": "seven_day",
              "label": "Week · all models",
              "percent": 17.5,
              "resetsAt": null
            }
          ],
          "fetchedAt": "2026-11-15T12:00:00.000Z"
        },
        "sent": {
          "authorization": "Bearer tok-good",
          "anthropic-beta": "oauth-2025-04-20"
        }
      }
    },
    {

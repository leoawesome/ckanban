{
  "name": "ckanban",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "bin": {
    "ckanban": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts dev",
    "test": "bun scripts/test.ts",
    "test:timings": "bun scripts/test.ts --update-timings",
    "build:web": "cd web && bun install && bun run build",
    "typecheck": "tsc --noEmit",
    "build:bin": "bun scripts/build-bin.ts"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}

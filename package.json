{
  "name": "ckanban",
  "version": "0.18.1",
  "private": true,
  "type": "module",
  "bin": {
    "ckanban": "src/cli.ts"
  },
  "scripts": {
    "dev": "scripts/build-rust.sh && rust/target/release/ckanban-rs dev",
    "test": "bun scripts/test.ts",
    "test:timings": "bun scripts/test.ts --update-timings",
    "test:contract": "bun scripts/test.ts ./test/contract",
    "build:rust": "scripts/build-rust.sh",
    "build:web": "cd web && bun install && bun run build",
    "typecheck": "tsc --noEmit",
    "build:bin": "bun scripts/build-bin.ts",
    "speedcheck": "bun scripts/speedcheck/run.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1"
  }
}
